# EAS archives the whole monorepo (no git here) — keep it small.
# node_modules is reinstalled on the build server; native dirs are regenerated by prebuild.
**/node_modules/**
**/android/**
**/ios/**
**/.expo/**
**/dist/**
**/build/**
**/bin/**
**/obj/**
**/out/**
**/release/**
**/.gradle/**
**/*.log
**/*.tgz
**/*.apk
**/*.aab
**/*.exe
